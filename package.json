{
  "name": "capsa",
  "private": true,
  "description": "TypeScript libraries published as @haco-studio packages",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "check:strict": "biome check --error-on-warnings .",
    "test": "vitest",
    "test:run": "vitest run --passWithNoTests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haco-studio/capsa.git"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  }
}
